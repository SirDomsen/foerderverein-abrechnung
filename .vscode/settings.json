{
  "actionButtons": {
    "reloadButton": null,
    "defaultColor": "#ffffff",
    "commands": [
      {
        "name": "$(gear) Build EXE",
        "color": "#4caf50",
        "tooltip": "Baut die AbrechnungsManager.exe mit PyInstaller",
        "singleInstance": true,
        "focus": true,
        "command": "python -m PyInstaller --noconsole --onefile --name AbrechnungsManager --collect-all customtkinter app_windows.py"
      },
      {
        "name": "$(browser) Start Web-App",
        "color": "#38bdf8",
        "tooltip": "Startet den NiceGUI Webserver (Web & Smartphone)",
        "singleInstance": true,
        "focus": true,
        "command": "python app_web.py"
      },
      {
        "name": "$(window) Start Desktop-App",
        "color": "#f59e0b",
        "tooltip": "Startet die native Windows-Desktop-Anwendung",
        "singleInstance": true,
        "focus": true,
        "command": "python app_windows.py"
      }
    ]
  }
}
