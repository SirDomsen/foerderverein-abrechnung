{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Windows EXE (PyInstaller)",
      "type": "shell",
      "command": "python -m PyInstaller --noconsole --onefile --name 'AbrechnungsManager' --collect-all customtkinter app_windows.py",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": []
    }
  ]
}